[template]
  <article class="home-page">
    <section class="home-hero">
      <div class="koppa-container home-hero__grid">
        <div class="home-hero__copy">
          <p class="koppa-eyebrow">KoppaJS Frontend Framework</p>
          <h1 class="home-hero__title">
            Build frontends that stay clear.
          </h1>
          <p class="home-hero__lead">
            A pragmatic, component-first framework for reactive web applications.
          </p>
          <p class="home-hero__summary">
            Less magic. More control. Modular where it matters,
            explicit where it counts.
          </p>

          <div class="home-hero__actions">
            <a class="koppa-button koppa-button--primary" href="/learn" data-route="/learn">
              Get Started
            </a>
            <a
              class="koppa-button"
              :href="githubHref"
              target="_blank"
              rel="noreferrer"
            >
              View GitHub
            </a>
          </div>

          <p class="home-hero__trust">
            Native custom elements · Focused core · Vite-powered builds
          </p>
        </div>
      </div>
    </section>

    <section class="home-section">
      <div class="koppa-container koppa-stack">
        <div class="home-section__header">
          <p class="koppa-eyebrow">What is KoppaJS?</p>
          <h2 class="home-section__title">A pragmatic framework for reactive web applications.</h2>
          <p class="koppa-text-muted">
            KoppaJS combines a small browser runtime, custom-element Components,
            Vite-powered builds, and explicit extension points into a
            framework that keeps reactive interfaces understandable.
          </p>
        </div>
        <div class="koppa-grid koppa-grid--4 home-feature-grid">
          <article loop="item in productItems" class="koppa-card koppa-card--quiet home-feature-card">
            <span if="item.icon === 'runtime'" class="home-feature-card__icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                focusable="false"
              >
                <path d="M12 20v2"></path>
                <path d="M12 2v2"></path>
                <path d="M17 20v2"></path>
                <path d="M17 2v2"></path>
                <path d="M2 12h2"></path>
                <path d="M2 17h2"></path>
                <path d="M2 7h2"></path>
                <path d="M20 12h2"></path>
                <path d="M20 17h2"></path>
                <path d="M20 7h2"></path>
                <path d="M7 20v2"></path>
                <path d="M7 2v2"></path>
                <rect x="4" y="4" width="16" height="16" rx="2"></rect>
                <rect x="8" y="8" width="8" height="8" rx="1"></rect>
              </svg>
            </span>
            <span if="item.icon === 'elements'" class="home-feature-card__icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                focusable="false"
              >
                <path
                  d="M15.536 11.293a1 1 0 0 0 0 1.414l2.376 2.377a1 1 0 0 0 1.414 0l2.377-2.377a1 1 0 0 0 0-1.414l-2.377-2.377a1 1 0 0 0-1.414 0z"
                ></path>
                <path
                  d="M2.297 11.293a1 1 0 0 0 0 1.414l2.377 2.377a1 1 0 0 0 1.414 0l2.377-2.377a1 1 0 0 0 0-1.414L6.088 8.916a1 1 0 0 0-1.414 0z"
                ></path>
                <path
                  d="M8.916 17.912a1 1 0 0 0 0 1.415l2.377 2.376a1 1 0 0 0 1.414 0l2.377-2.376a1 1 0 0 0 0-1.415l-2.377-2.376a1 1 0 0 0-1.414 0z"
                ></path>
                <path
                  d="M8.916 4.674a1 1 0 0 0 0 1.414l2.377 2.376a1 1 0 0 0 1.414 0l2.377-2.376a1 1 0 0 0 0-1.414l-2.377-2.377a1 1 0 0 0-1.414 0z"
                ></path>
              </svg>
            </span>
            <span if="item.icon === 'build'" class="home-feature-card__icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                focusable="false"
              >
                <path
                  d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"
                ></path>
              </svg>
            </span>
            <span if="item.icon === 'extensions'" class="home-feature-card__icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                focusable="false"
              >
                <path
                  d="M15.39 4.39a1 1 0 0 0 1.68-.474 2.5 2.5 0 1 1 3.014 3.015 1 1 0 0 0-.474 1.68l1.683 1.682a2.414 2.414 0 0 1 0 3.414L19.61 15.39a1 1 0 0 1-1.68-.474 2.5 2.5 0 1 0-3.014 3.015 1 1 0 0 1 .474 1.68l-1.683 1.682a2.414 2.414 0 0 1-3.414 0L8.61 19.61a1 1 0 0 0-1.68.474 2.5 2.5 0 1 1-3.014-3.015 1 1 0 0 0 .474-1.68l-1.683-1.682a2.414 2.414 0 0 1 0-3.414L4.39 8.61a1 1 0 0 1 1.68.474 2.5 2.5 0 1 0 3.014-3.015 1 1 0 0 1-.474-1.68l1.683-1.682a2.414 2.414 0 0 1 3.414 0z"
                ></path>
              </svg>
            </span>
            <h3>{{ item.title }}</h3>
            <p class="koppa-text-muted">{{ item.body }}</p>
          </article>
        </div>
      </div>
    </section>

    <section class="home-section">
      <div class="koppa-container koppa-stack">
        <div class="home-section__header">
          <p class="koppa-eyebrow">Core Benefits</p>
          <h2 class="home-section__title">Clarity, control, and a smaller runtime.</h2>
          <p class="koppa-text-muted">
            KoppaJS is designed for teams that want component-based development,
            modular growth, and low-overhead runtime behavior without hiding the
            application shape.
          </p>
        </div>
        <div class="koppa-grid koppa-grid--4">
          <article loop="item in promiseItems" class="koppa-card koppa-card--quiet">
            <h3>{{ item.title }}</h3>
            <p class="koppa-text-muted">{{ item.body }}</p>
          </article>
        </div>
      </div>
    </section>

    <section class="home-section">
      <div class="koppa-container koppa-stack">
        <div class="home-section__header">
          <p class="koppa-eyebrow">Why KoppaJS?</p>
          <h2 class="home-section__title">Less magic. More control.</h2>
          <p class="koppa-text-muted">
            Frontend systems become expensive when the framework hides too much:
            implicit flows, oversized APIs, and runtime behavior that is hard to
            inspect. KoppaJS keeps the surface small so teams can understand what
            their applications are doing.
          </p>
        </div>
      </div>
    </section>

    <section class="home-section">
      <div class="koppa-container koppa-stack">
        <div class="koppa-grid koppa-grid--2">
          <article class="koppa-card koppa-card--quiet">
            <p class="koppa-eyebrow">Component-first</p>
            <h2>Components render as native custom elements.</h2>
            <p class="koppa-text-muted">
              Components are not a layer added after the fact. KoppaJS registers
              them with the browser's Custom Elements API and keeps UI
              structure, behavior, and reuse close enough to reason about.
            </p>
          </article>

          <article class="koppa-card koppa-card--quiet">
            <p class="koppa-eyebrow">Modular by design</p>
            <h2>Use the pieces your product actually needs.</h2>
            <p class="koppa-text-muted">
              Core, routing, build tooling, and documentation are separate
              capabilities. That keeps the framework small while still giving
              teams a path from first component to a reactive application.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="home-section">
      <div class="koppa-container koppa-stack">
        <div class="home-section__header">
          <p class="koppa-eyebrow">Performance Through Reduction</p>
          <h2 class="home-section__title">Low overhead starts with a small runtime.</h2>
          <p class="koppa-text-muted">
            KoppaJS is built to keep runtime work constrained. The core
            registers custom elements, runs reactive components, and leaves .kpa
            parsing, TypeScript, Sass, and custom-element identity attributes to
            the Vite plugin.
          </p>
        </div>
        <div class="koppa-grid koppa-grid--3">
          <article loop="item in performanceItems" class="koppa-card koppa-card--quiet">
            <h3>{{ item.title }}</h3>
            <p class="koppa-text-muted">{{ item.body }}</p>
          </article>
        </div>
      </div>
    </section>

    <section class="home-section">
      <div class="koppa-container koppa-stack">
        <div class="koppa-card koppa-card--quiet home-final-cta">
          <p class="koppa-eyebrow">Intentional Architecture</p>
          <h2>Modular where it matters. Explicit where it counts.</h2>
          <p class="koppa-text-muted">
            KoppaJS keeps architecture practical: every public capability should
            have a clear purpose, every layer should be explainable, and every
            application should remain readable after the first release.
          </p>
          <div class="home-hero__actions">
            <a class="koppa-button koppa-button--primary" href="/learn" data-route="/learn">
              Get Started
            </a>
            <a
              class="koppa-button"
              :href="docsOverviewHref"
              :data-route="docsOverviewHref"
            >
              Read the Docs
            </a>
          </div>
        </div>
      </div>
    </section>
  </article>
[/template]

[ts]
  import { getDocumentationRouteMap } from "koppajs-documentation/routes";

  import { siteMeta } from "../site-config";
  import {
    homePerformanceCards,
    homeProductCards,
    homePromiseCards,
  } from "../site-content";

  return {
    state: {
      docsOverviewHref: "/docs",
      githubHref: siteMeta.githubOrgUrl,
      productItems: homeProductCards,
      promiseItems: homePromiseCards,
      performanceItems: homePerformanceCards,
    },
    methods: {
      syncDocsLinks() {
        const routeMap = getDocumentationRouteMap();

        this.docsOverviewHref = routeMap["/"] ?? "/docs";
      },
    },
    created() {
      this.syncDocsLinks();
    },
  };
[/ts]
