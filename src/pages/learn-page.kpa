[template]
  <article class="site-page">
    <section class="site-page__hero">
      <div class="koppa-container site-page__hero-copy">
        <p class="koppa-eyebrow">Learn</p>
        <h1 class="site-page__title">Start building with a clear path.</h1>
        <p class="site-page__lead">
          Choose the first step that matches your goal: install the framework,
          build your first Component, understand the model, or move into examples.
        </p>
      </div>
    </section>

    <section class="site-page__section">
      <div class="koppa-container koppa-grid koppa-grid--3">
        <article loop="item in startPaths" class="koppa-card koppa-card--quiet">
          <p class="koppa-eyebrow">{{ item.kicker }}</p>
          <h2>{{ item.title }}</h2>
          <p class="koppa-text-muted">{{ item.body }}</p>
          <a class="koppa-link" :href="item.href" :data-route="item.href">{{ item.linkLabel }}</a>
        </article>
      </div>
    </section>

    <section class="site-page__section">
      <div class="koppa-container koppa-stack">
        <div class="home-section__header">
          <p class="koppa-eyebrow">Learning Paths</p>
          <h2 class="home-section__title">Move from product promise to working code.</h2>
          <p class="koppa-text-muted">
            The documentation goes deeper when you need implementation detail.
            Start with the path closest to what you are trying to build.
          </p>
        </div>

        <div class="koppa-grid koppa-grid--3">
          <article loop="item in docsAreas" class="koppa-card koppa-card--quiet">
            <p class="koppa-eyebrow">{{ item.kicker }}</p>
            <h2>{{ item.title }}</h2>
            <p class="koppa-text-muted">{{ item.body }}</p>
            <a class="koppa-link" :href="item.href" :data-route="item.href">{{ item.linkLabel }}</a>
          </article>
        </div>
      </div>
    </section>

    <section class="site-page__section">
      <div class="koppa-container site-learn__grid">
        <div class="koppa-card">
          <p class="koppa-eyebrow">Documentation Topics</p>
          <h2>Explore the technical guide by topic.</h2>
          <div class="site-learn__nav-tree">
            <div loop="item in docsItems" class="site-learn__nav-group">
              <a class="site-learn__nav-link" :href="item.href" :data-route="item.href">
                {{ item.label }}
              </a>
              <div if="item.children.length" class="site-learn__nav-children">
                <a
                  loop="child in item.children"
                  class="site-learn__nav-child"
                  :href="child.href"
                  :data-route="child.href"
                >
                  {{ child.label }}
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="koppa-stack">
          <aside class="koppa-card koppa-card--quiet">
            <p class="koppa-eyebrow">Reading Order</p>
            <ol class="koppa-list">
              <li>Install the baseline and render a first Component.</li>
              <li>Read core concepts to understand how KoppaJS structures UI work.</li>
              <li>Add routing and tooling knowledge when the product surface grows.</li>
              <li>Use examples, packages, and migration notes for real application shape.</li>
            </ol>
          </aside>

          <aside class="koppa-card koppa-card--quiet">
            <p class="koppa-eyebrow">Product And Docs</p>
            <ul class="koppa-list">
              <li>The website explains why KoppaJS is worth evaluating.</li>
              <li>The docs explain how the framework works in code.</li>
              <li>Use this page when you know the outcome but not the next technical step.</li>
            </ul>
          </aside>
        </div>
      </div>
    </section>
  </article>
[/template]

[ts]
  import {
    getDocumentationNavigationItems,
    getDocumentationRouteMap,
  } from "koppajs-documentation/routes";

  return {
    state: {
      docsItems: [],
      docsAreas: [],
      startPaths: [],
    },
    created() {
      const routeMap = getDocumentationRouteMap();

      this.docsItems = getDocumentationNavigationItems();
      this.docsAreas = this.docsItems.map((item) => ({
        kicker: `${item.children.length} topic${item.children.length === 1 ? "" : "s"}`,
        title: item.label,
        body: item.description,
        href: item.children[0]?.href ?? item.href,
        linkLabel: item.children.length ? "Open topic" : "Open page",
      }));
      this.startPaths = [
        {
          kicker: "Start",
          title: "Install and render a Component",
          body: "Get the supported baseline running and see KoppaJS on screen before adding routing or extra packages.",
          href: routeMap["/getting-started/installation"] ?? "/docs/getting-started/installation",
          linkLabel: "Open installation",
        },
        {
          kicker: "Understand",
          title: "Learn the component model",
          body: "Read how Components, templates, state, props, events, slots, and lifecycle fit together.",
          href: routeMap["/core-concepts/components"] ?? "/docs/core-concepts/components",
          linkLabel: "Open components",
        },
        {
          kicker: "Build",
          title: "Move into examples",
          body: "Use examples once you are ready to shape a routed, maintainable application.",
          href: routeMap["/examples"] ?? "/docs/examples",
          linkLabel: "Open examples",
        },
      ];
    },
  };
[/ts]
